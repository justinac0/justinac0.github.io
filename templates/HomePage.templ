package templates

import (
	"justinac0.github.io/internal/types"
	"strings"
)

templ PortfolioItem(item types.Portfolio) {
	<div class="portfolio-item" style={ "position: relative;" }>
		if len(item.ImageUrl) > 0 {
			<img src={ item.ImageUrl }/>
		}
		<div class="portfolio-item-info">
			<h3 style="margin: 0;">{ item.Title }</h3>
			<p class="portfolio-item-about">
				@templ.Raw(string(item.About))
			</p>
			<a style="z-index:100;" target="_blank" href={ item.GithubUrl }>github</a>
		</div>
	</div>
}

templ FancyPortfolioView(items []types.Portfolio) {
	<div id="portfolio">
		<h1>Portfolio</h1>
		<div class="portfolio-list">
			for _, w := range(items) {
				@PortfolioItem(w)
			}
		</div>
	</div>
}

templ HomePage(relPath string, page types.Page, pages types.Pages, portfolio []types.Portfolio) {
	@ArticleLayout(relPath, page.Meta.Title) {
		<div id="about">
			@templ.Raw(string(page.HTML))
		</div>
		<br/>
		@FancyPortfolioView(portfolio)
		<div id="blogs">
			<h1>Blogs</h1>
			<p>WIP...</p>
			for _, p := range pages {
				<nav>
					if strings.Contains(p.Url, "blogs") && p.Meta.Draft == false {
						<ul>
							<p>
								<span style="color: gray"><i>{ p.Meta.Date }</i></span>
								if len(relPath) > 0 {
									<a href={ p.Url }>{ p.Meta.Title }</a>
								} else {
									<a href={ p.Url + ".html" }>{ p.Meta.Title }</a>
								}
							</p>
						</ul>
					}
				</nav>
			}
		</div>
	}
}
