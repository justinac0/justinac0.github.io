package templates

import (
	"justinac0.github.io/internal/page"
	"justinac0.github.io/internal/portfolio"
	"strings"
)

templ PortfolioItem(item portfolio.Portfolio) {
	<div class="portfolio-item" style={ "position: relative;" }>
		<img src={ item.ImageUrl }/>
		<div class="portfolio-item-info">
			<h3 style="margin-bottom: 0;">{ item.Title }</h3>
			<p class="portfolio-item-about">
				{ item.About }
			</p>
			<a target="_blank" href={ item.GithubUrl }>github</a>
		</div>
	</div>
}

templ FancyPortfolioView(left []portfolio.Portfolio, right []portfolio.Portfolio) {
	<div id="portfolio">
		<h2>Portfolio</h2>
		<div id="portfolio-list">
			<div>
				for _, w := range(left) {
					@PortfolioItem(w)
				}
			</div>
			<div>
				for _, w := range(right) {
					@PortfolioItem(w)
				}
			</div>
		</div>
	</div>
}

templ HomePage(home page.Page, pages page.Pages, work []portfolio.Portfolio) {
	{{ rightColumn := work[len(work)/2:] }}
	{{ leftColumn := work[:len(work)/2] }}
	@ArticleLayout(home.Meta.Title) {
		<div id="about">
			@templ.Raw(string(home.HTML))
		</div>
		@FancyPortfolioView(leftColumn, rightColumn)
		<div id="blogs">
			<h2>Blogs</h2>
			for _, p := range pages {
				<nav>
					if strings.Compare(p.Url, "/") != 0 {
						<ul><p><span style="color: gray"><i>{ p.Meta.Date }</i></span> <a href={ p.Url }>{ p.Meta.Title }</a></p></ul>
					}
				</nav>
			}
		</div>
	}
}
